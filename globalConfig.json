{
    "pages": {
        "configuration": {
            "title": "Configuration",
            "description": "Set up the mTLS listener and map client certificates to Splunk accounts.",
            "tabs": [
                {
                    "name": "mappings",
                    "title": "Mappings",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Identity type",
                                "field": "identity_type"
                            },
                            {
                                "label": "Identity",
                                "field": "identity_value"
                            },
                            {
                                "label": "Proxies users",
                                "field": "proxies_users"
                            },
                            {
                                "label": "Splunk account",
                                "field": "account"
                            },
                            {
                                "label": "Token expires",
                                "field": "token_expiry"
                            }
                        ],
                        "moreInfo": [
                            {
                                "label": "Issuer",
                                "field": "issuer"
                            },
                            {
                                "label": "Identity type",
                                "field": "identity_type"
                            },
                            {
                                "label": "Identity",
                                "field": "identity_value"
                            },
                            {
                                "label": "Proxies users",
                                "field": "proxies_users"
                            },
                            {
                                "label": "Splunk account",
                                "field": "account"
                            },
                            {
                                "label": "Token expires",
                                "field": "token_expiry"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for this mapping.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Name must begin with a letter and contain only letters, digits and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Name must be 1 to 100 characters.",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Issuer DN",
                            "field": "issuer",
                            "help": "The issuing CA's distinguished name in RFC 4514 form, for example CN=Issuing CA,O=Example,C=US. The unmapped-certificate audit event and bin/inspect-cert show the exact value.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Issuer DN must be 1 to 1024 characters.",
                                    "minLength": 1,
                                    "maxLength": 1024
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Identity type",
                            "field": "identity_type",
                            "help": "Which certificate field identifies the client. A mapping matches if any field of this type holds the identity.",
                            "required": true,
                            "defaultValue": "URI",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "URI",
                                        "label": "URI (subject alternative name)"
                                    },
                                    {
                                        "value": "DNS",
                                        "label": "DNS name (subject alternative name)"
                                    },
                                    {
                                        "value": "EMAIL",
                                        "label": "Email (subject alternative name)"
                                    },
                                    {
                                        "value": "UPN",
                                        "label": "UPN (Microsoft principal name)"
                                    },
                                    {
                                        "value": "IP",
                                        "label": "IP address (subject alternative name)"
                                    },
                                    {
                                        "value": "CN",
                                        "label": "Subject common name"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "text",
                            "label": "Identity",
                            "field": "identity_value",
                            "help": "The identity value, for example spiffe://example.org/agent or agent.example.org. DNS, email and UPN values ignore case; URI and CN values must match exactly; IP addresses match in any notation.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Identity must be 1 to 1024 characters.",
                                    "minLength": 1,
                                    "maxLength": 1024
                                }
                            ]
                        },
                        {
                            "type": "checkbox",
                            "label": "Proxies users",
                            "field": "proxies_users",
                            "help": "Check this if the client acts for many users and names each call's user in the X-ProxiedEntitiesChain header. Its calls then run as the role account the user's rule picks, so it needs no Splunk account or token of its own.",
                            "defaultValue": 0,
                            "modifyFieldsOnValue": [
                                {
                                    "fieldValue": 1,
                                    "fieldsToModify": [
                                        {
                                            "fieldId": "account",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token_expiry",
                                            "display": false,
                                            "required": false
                                        }
                                    ]
                                },
                                {
                                    "fieldValue": true,
                                    "fieldsToModify": [
                                        {
                                            "fieldId": "account",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token_expiry",
                                            "display": false,
                                            "required": false
                                        }
                                    ]
                                },
                                {
                                    "fieldValue": "1",
                                    "fieldsToModify": [
                                        {
                                            "fieldId": "account",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token",
                                            "display": false,
                                            "required": false
                                        },
                                        {
                                            "fieldId": "token_expiry",
                                            "display": false,
                                            "required": false
                                        }
                                    ]
                                },
                                {
                                    "fieldValue": "[[any_other_value]]",
                                    "fieldsToModify": [
                                        {
                                            "fieldId": "account",
                                            "display": true,
                                            "required": true
                                        },
                                        {
                                            "fieldId": "token",
                                            "display": true,
                                            "required": true
                                        },
                                        {
                                            "fieldId": "token_expiry",
                                            "display": true,
                                            "required": true
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Splunk account",
                            "field": "account",
                            "help": "The local Splunk account this client acts as. The token below must belong to it. Not used when the client proxies users.",
                            "required": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Account must be 1 to 256 characters.",
                                    "minLength": 1,
                                    "maxLength": 256
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "MCP token",
                            "field": "token",
                            "help": "The account's encrypted MCP token from the Splunk MCP Server app. Stored encrypted in Splunk's credential store.",
                            "required": false,
                            "encrypted": true
                        },
                        {
                            "type": "text",
                            "label": "Token expiry date",
                            "field": "token_expiry",
                            "help": "The date the token expires, as YYYY-MM-DD. The bridge warns 14 days ahead.",
                            "required": false,
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                                    "errorMsg": "Enter the expiry date as YYYY-MM-DD."
                                }
                            ]
                        }
                    ],
                    "restHandlerModule": "mtls_bridge_mappings_handler",
                    "restHandlerClass": "MappingsHandler"
                },
                {
                    "name": "role_accounts",
                    "title": "Role accounts",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Splunk account",
                                "field": "account"
                            },
                            {
                                "label": "Token expires",
                                "field": "token_expiry"
                            }
                        ],
                        "moreInfo": [
                            {
                                "label": "Splunk account",
                                "field": "account"
                            },
                            {
                                "label": "Token expires",
                                "field": "token_expiry"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for this role account. User rules pick it by this name.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Name must begin with a letter and contain only letters, digits and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Name must be 1 to 100 characters.",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Splunk account",
                            "field": "account",
                            "help": "A local Splunk account holding the roles this group of users should have. The token below must belong to it.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Account must be 1 to 256 characters.",
                                    "minLength": 1,
                                    "maxLength": 256
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "MCP token",
                            "field": "token",
                            "help": "The account's encrypted MCP token from the Splunk MCP Server app. Stored encrypted in Splunk's credential store.",
                            "required": true,
                            "encrypted": true
                        },
                        {
                            "type": "text",
                            "label": "Token expiry date",
                            "field": "token_expiry",
                            "help": "The date the token expires, as YYYY-MM-DD. The bridge warns 14 days ahead.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                                    "errorMsg": "Enter the expiry date as YYYY-MM-DD."
                                }
                            ]
                        }
                    ],
                    "restHandlerModule": "mtls_bridge_role_accounts_handler",
                    "restHandlerClass": "RoleAccountsHandler"
                },
                {
                    "name": "user_rules",
                    "title": "User rules",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Match",
                                "field": "match"
                            },
                            {
                                "label": "Value",
                                "field": "value"
                            },
                            {
                                "label": "Role account",
                                "field": "role_account"
                            }
                        ],
                        "moreInfo": [
                            {
                                "label": "Match",
                                "field": "match"
                            },
                            {
                                "label": "Value",
                                "field": "value"
                            },
                            {
                                "label": "Role account",
                                "field": "role_account"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for this rule. Audit events name the rule each proxied call matched.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Name must begin with a letter and contain only letters, digits and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Name must be 1 to 100 characters.",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Match",
                            "field": "match",
                            "help": "Exact DN matches one user. Attributes matches every user whose DN holds all of the value's attributes, in any position. An exact DN rule wins over attribute rules; a user matching two attribute rules is refused.",
                            "required": true,
                            "defaultValue": "dn",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "dn",
                                        "label": "Exact DN"
                                    },
                                    {
                                        "value": "attributes",
                                        "label": "Attributes (all must be in the DN)"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "text",
                            "label": "Value",
                            "field": "value",
                            "help": "For Exact DN, the user's distinguished name, such as CN=John Smith,OU=Users,O=Org,C=US. For Attributes, the attributes every matching DN must hold, such as OU=Analysts,O=Org. Case and spacing are ignored.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Value must be 1 to 4096 characters.",
                                    "minLength": 1,
                                    "maxLength": 4096
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Role account",
                            "field": "role_account",
                            "help": "The role account matching users' calls run as.",
                            "required": true,
                            "options": {
                                "referenceName": "role_accounts"
                            }
                        }
                    ],
                    "restHandlerModule": "mtls_bridge_user_rules_handler",
                    "restHandlerClass": "UserRulesHandler"
                },
                {
                    "name": "listener",
                    "title": "Listener",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Bind address",
                            "field": "listen_host",
                            "defaultValue": "0.0.0.0",
                            "help": "The address the mTLS listener binds to.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Port",
                            "field": "listen_port",
                            "defaultValue": "8443",
                            "help": "The port the mTLS listener binds to. Open it in the host firewall.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        1,
                                        65535
                                    ],
                                    "errorMsg": "Port must be between 1 and 65535."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Client CA bundle",
                            "field": "ca_bundle",
                            "help": "Path to a PEM file holding the CAs that issue client certificates. $SPLUNK_HOME is expanded.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Listener certificate",
                            "field": "server_cert",
                            "help": "Path to the listener's PEM certificate. Leave empty to use splunkd's server certificate."
                        },
                        {
                            "type": "text",
                            "label": "Listener key",
                            "field": "server_key",
                            "help": "Path to the listener's PEM private key. Leave empty if the certificate file also holds the key."
                        },
                        {
                            "type": "text",
                            "label": "Listener key password",
                            "field": "server_key_password",
                            "help": "Password for the listener key, if it is encrypted.",
                            "encrypted": true
                        },
                        {
                            "type": "text",
                            "label": "Client CRL file",
                            "field": "crl_file",
                            "required": false,
                            "help": "Optional. A CRL file (PEM or DER) that your PKI tooling keeps up to date, for example $SPLUNK_HOME/etc/auth/clients.crl. It must hold a CRL from every CA that issues client certificates (and, for chain checking, from every CA in their chains). Leave empty to turn revocation checking off."
                        },
                        {
                            "type": "singleSelect",
                            "label": "CRL check depth",
                            "field": "crl_check",
                            "defaultValue": "leaf",
                            "required": false,
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "leaf",
                                        "label": "Client certificate only (leaf)"
                                    },
                                    {
                                        "value": "chain",
                                        "label": "Whole chain"
                                    }
                                ]
                            },
                            "help": "Whether the CRL is checked for the client certificate only, or for every certificate in its chain."
                        },
                        {
                            "type": "singleSelect",
                            "label": "When the CRL expires",
                            "field": "crl_expiry",
                            "defaultValue": "fail_closed",
                            "required": false,
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "fail_closed",
                                        "label": "Reject all clients (fail closed)"
                                    },
                                    {
                                        "value": "fail_open",
                                        "label": "Stop checking revocation and warn (fail open)"
                                    }
                                ]
                            },
                            "help": "What happens once the CRL passes its nextUpdate time without a fresh CRL. The bridge warns 24 hours ahead."
                        },
                        {
                            "type": "text",
                            "label": "Max concurrent requests per user",
                            "field": "max_concurrent_per_user",
                            "defaultValue": "2",
                            "help": "How many calls one user behind a client that proxies users may have in flight at once. The client's own limit still applies.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        1,
                                        1000
                                    ],
                                    "errorMsg": "Must be between 1 and 1000."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "MCP Server URL",
                            "field": "upstream_url",
                            "defaultValue": "https://127.0.0.1:8089/services/mcp",
                            "help": "Where the Splunk MCP Server app listens.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^https://",
                                    "errorMsg": "The MCP Server URL must use https."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "MCP Server CA bundle",
                            "field": "upstream_ca_bundle",
                            "help": "Path to the PEM CA bundle that verifies splunkd's certificate. Leave empty for $SPLUNK_HOME/etc/auth/cacert.pem."
                        },
                        {
                            "type": "checkbox",
                            "label": "Check MCP Server hostname",
                            "field": "upstream_verify_hostname",
                            "help": "Check that splunkd's certificate names the MCP Server URL's host. Splunk's default certificate doesn't name 127.0.0.1."
                        }
                    ]
                },
                {
                    "name": "audit",
                    "title": "Audit",
                    "entity": [
                        {
                            "type": "checkbox",
                            "label": "Send the audit log to an index",
                            "field": "audit_forwarding",
                            "defaultValue": true,
                            "help": "When off, Splunk stops indexing the audit file. The bridge still writes it to $SPLUNK_HOME/var/log/TA-mtls-bridge/audit.log."
                        },
                        {
                            "type": "text",
                            "label": "Audit index",
                            "field": "audit_index",
                            "defaultValue": "main",
                            "required": true,
                            "help": "The index for audit events (sourcetype mtls_bridge:audit). The index must already exist.",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                                    "errorMsg": "Index names use lowercase letters, digits, underscores and hyphens."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "meta": {
        "name": "TA-mtls-bridge",
        "restRoot": "ta_mtls_bridge",
        "version": "0.1.1",
        "displayName": "mTLS Bridge for Splunk MCP",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ],
        "supportedPythonVersion": [
            "3.9",
            "3.13"
        ],
        "checkForUpdates": false
    }
}
