# App objects (setup page, navigation) are visible to everyone; only admins change them.
[]
access = read : [ * ], write : [ admin, sc_admin ]

# Only admins may read the bridge's settings, its mappings, or the credential store entries
# that hold their tokens. The daemon reads them with splunkd's own session key.
[ta_mtls_bridge_mappings]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[ta_mtls_bridge_settings]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[passwords]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
